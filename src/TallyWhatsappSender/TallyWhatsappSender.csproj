<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AnyCPU on purpose: the DLL then loads into whichever process hosts it.
         A 32-bit TallyPrime gets a 32-bit instance, a 64-bit TallyPrime gets a
         64-bit one, so the add-on no longer depends on guessing Tally's
         architecture. Register it in BOTH registry views (see install.ps1). -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>

    <!-- Deliberately NOT strong-named. regasm /codebase is happy with an
         unsigned assembly (it prints advisory warning RA0000, nothing more),
         and a strong-named assembly cannot reference Selenium's WebDriver.dll,
         which has no strong name: the CLR then fails with HRESULT 0x80131044
         ("A strongly-named assembly is required") the moment the first
         Selenium type is touched. That failure happened before SendCore could
         log anything, which is why Tally showed no error and sent nothing. -->
    <SignAssembly>false</SignAssembly>
    <AssemblyName>TallyWhatsappSender</AssemblyName>
    <RootNamespace>TallyWhatsappSender</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets net48 build on any machine (even without the VS targeting pack). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Selenium.WebDriver" Version="4.9.0" />
  </ItemGroup>

</Project>

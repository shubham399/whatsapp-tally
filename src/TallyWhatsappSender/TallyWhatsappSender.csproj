<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AnyCPU on purpose: the DLL then loads into whichever process hosts it.
         A 32-bit TallyPrime gets a 32-bit instance, a 64-bit TallyPrime gets a
         64-bit one, so the add-on no longer depends on guessing Tally's
         architecture. Register it in BOTH registry views (see install.ps1). -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>

    <!-- Strong name. regasm /codebase is documented to be used with signed
         assemblies (unsigned ones trigger warning RA0000). The key file holds
         only the public key, so this is a "public signed" identity: it gives
         the assembly a strong name without a Windows code-signing certificate.
         That is all /codebase needs - it is not Authenticode signing. -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>TallyWhatsappSender.snk</AssemblyOriginatorKeyFile>
    <!-- CS8002: Selenium's WebDriver.dll is not strong named. A strong-named
         assembly may reference an unsigned one at runtime, so this is only
         informational. -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
    <AssemblyName>TallyWhatsappSender</AssemblyName>
    <RootNamespace>TallyWhatsappSender</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets net48 build on any machine (even without the VS targeting pack). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Selenium.WebDriver" Version="4.25.0" />
  </ItemGroup>

</Project>
